<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pages" android:layout_width="fill_parent" android:layout_height="fill_parent"><ScrollView android:layout_width="fill_parent" android:layout_height="fill_parent"><LinearLayout android:layout_width="fill_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"><TextView android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="Create ON Account" android:textSize="24sp" android:textColor="#68558E"/><EditText android:id="@+id/name" android:layout_width="fill_parent" android:layout_height="wrap_content" android:hint="First name" android:inputType="textPersonName" android:saveEnabled="true"/><EditText android:id="@+id/surname" android:layout_width="fill_parent" android:layout_height="wrap_content" android:hint="Surname (optional)" android:inputType="textPersonName" android:saveEnabled="true"/><EditText android:id="@+id/email" android:layout_width="fill_parent" android:layout_height="wrap_content" android:hint="Email" android:inputType="textEmailAddress" android:saveEnabled="true"/><EditText android:id="@+id/username" android:layout_width="fill_parent" android:layout_height="wrap_content" android:hint="Username" android:inputType="text" android:saveEnabled="true"/><EditText android:id="@+id/password" android:layout_width="fill_parent" android:layout_height="wrap_content" android:hint="Password" android:inputType="textPassword" android:saveEnabled="false"/><Button android:id="@+id/read_rules" style="@style/LiteButton" android:text="Read Platform Rules"/><CheckBox android:id="@+id/accept" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="I accept the Platform Rules" android:enabled="false"/><Button android:id="@+id/create" style="@style/LiteButton" android:text="Create account"/><TextView android:id="@+id/status" android:layout_width="fill_parent" android:layout_height="wrap_content" android:textColor="#008FA8"/></LinearLayout></ScrollView><LinearLayout android:layout_width="fill_parent" android:layout_height="fill_parent" android:orientation="vertical" android:padding="12dp"><ScrollView android:id="@+id/rules_scroll" android:layout_width="fill_parent" android:layout_height="0dp" android:layout_weight="1"><TextView android:id="@+id/rules_text" android:layout_width="fill_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#222222"/></ScrollView><Button android:id="@+id/rules_back" style="@style/LiteButton" android:text="Back to registration"/></LinearLayout></ViewFlipper>